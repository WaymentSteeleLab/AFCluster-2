Universe   = container
container_image = oras://ghcr.io/hwaymentsteele/afcluster2:0.1
Executable = run_afneighborcluster_chtc.sh
Arguments = $(NAME) $(SEQ)
USERNAME = $ENV(USER)

transfer_input_files = /home/$(USERNAME)/AFCluster-2, osdf:///chtc/staging/$(USERNAME)/af2_weights

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = results_a3m, results_pdb, $(NAME).a3m

+WantGPULab = true
+want_campus_pools = true
+want_ospool = true
request_cpus = 1
request_memory = 20GB
retry_request_memory = 40GB
request_disk = 30GB
request_gpus = 1
gpus_minimum_memory = 10000
+GPUJobLength = "short"

batch_name = afneighborcluster
stream_output = true
output = condor_log/$(batch_name)_$(Cluster)_$(Process).out
error = condor_log/$(batch_name)_$(Cluster)_$(Process).err
log = condor_log/$(batch_name)_$(Cluster)_$(Process).log

Queue NAME,SEQ from input_seqs.csv
